{
  "schema": "velvet.runtime.up2_dependency_manifest.v2",
  "target": {
    "node": "Founder UP2",
    "operating_system": "Ubuntu Linux",
    "python": {
      "baseline": {
        "minimum": "3.8",
        "maximum_exclusive": "3.13",
        "purpose": "safe bootstrap, dependency doctor, snapshots, read-only Runtime, and minimal Interface"
      },
      "preferred": {
        "minimum": "3.10",
        "maximum_exclusive": "3.13",
        "purpose": "full current CI coverage and newer optional capabilities"
      }
    }
  },
  "system_commands": [
    "git",
    "python3"
  ],
  "python_imports": [
    "yaml",
    "velvet_event_protocol",
    "velvet_continuity"
  ],
  "optional_python_imports": [
    "velvet_vehicle_can"
  ],
  "interface": {
    "enabled": true,
    "python_imports": [
      "PyQt5",
      "velvet_interface"
    ],
    "boot_window": "examples/runtime_boot_window.py"
  },
  "security": {
    "network_listener_required": false,
    "physical_authority_granted": false,
    "actuation_required": false,
    "automatic_install_allowed": false
  }
}
