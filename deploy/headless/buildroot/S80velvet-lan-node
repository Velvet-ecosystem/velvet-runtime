#!/bin/sh

DAEMON=/usr/bin/python3
REPO=/opt/velvet/velvet-runtime
CONFIG=/etc/velvet/lan-node.json
PIDFILE=/var/run/velvet-headless-lan-node.pid
NAME=velvet-headless-lan-node

start() {
    printf 'Starting %s: ' "$NAME"
    if [ ! -x "$DAEMON" ]; then
        echo "missing python3"
        return 1
    fi
    if [ ! -r "$CONFIG" ]; then
        echo "missing $CONFIG"
        return 1
    fi
    if [ ! -d "$REPO/services" ]; then
        echo "missing $REPO"
        return 1
    fi
    if ! "$DAEMON" -c 'import velvet_communications' >/dev/null 2>&1; then
        echo "missing velvet-communications"
        return 1
    fi
    if ! id velvet >/dev/null 2>&1; then
        echo "missing velvet service user"
        return 1
    fi
    mkdir -p /var/lib/velvet-node /var/run
    chown velvet:velvet /var/lib/velvet-node
    cd "$REPO" || return 1
    start-stop-daemon -S -b -m -p "$PIDFILE" -c velvet -x "$DAEMON" -- \
        -m services.headless_lan_node_daemon --config "$CONFIG"
    status=$?
    [ "$status" -eq 0 ] && echo "OK" || echo "FAIL"
    return "$status"
}

stop() {
    printf 'Stopping %s: ' "$NAME"
    if [ ! -f "$PIDFILE" ]; then
        echo "not running"
        return 0
    fi
    start-stop-daemon -K -p "$PIDFILE" -s TERM >/dev/null 2>&1 || true
    sleep 1
    if [ -f "$PIDFILE" ]; then
        start-stop-daemon -K -p "$PIDFILE" -s KILL >/dev/null 2>&1 || true
    fi
    rm -f "$PIDFILE"
    echo "OK"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
