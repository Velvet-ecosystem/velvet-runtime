[Unit]
Description=Velvet Founder Body Runtime with Authenticated LAN Bridge
Documentation=file:/opt/velvet/velvet-runtime/docs/headless_lan_nodes.md
After=local-fs.target network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=velvet
Group=velvet
WorkingDirectory=/opt/velvet/velvet-runtime
ExecStart=/usr/bin/python3 -m services.founder_lan_bridge_daemon --config /etc/velvet/founder-lan-bridge.json
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/velvet/state /var/lib/velvet-node
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
