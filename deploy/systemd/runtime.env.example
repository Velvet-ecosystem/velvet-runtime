# Copy to /etc/velvet/runtime.env and adjust only local paths.
# Do not commit real keys, identity proof material, or private state.

VELVET_CONTINUITY_IDENTITY_PATH=/opt/velvet/state/continuity/identity_chain.json
VELVET_CONTINUITY_PROOF_PATH=/opt/velvet/state/continuity/proof_material.bin
VELVET_SURFACE_METADATA_PATH=/opt/velvet/state/continuity/surface_identity.json
VELVET_BODY_REGISTRY_PATH=/opt/velvet/state/body/registry.json
VELVET_PROFILE_REGISTRY_PATH=/opt/velvet/state/profiles/registry.json
VELVET_SESSION_CONTEXT_PATH=/opt/velvet/state/session/current.json
VELVET_CAPABILITY_CONTEXT_PATH=/opt/velvet/state/policy/capability_context.json
VELVET_COURT_POLICY_PATH=/opt/velvet/state/policy/court_policy.json
VELVET_COURT_SIGNING_KEY_PATH=/opt/velvet/state/court/signing_key.bin
VELVET_CONTINUITY_RECEIPTS_PATH=/opt/velvet/state/receipts/continuity.log
VELVET_EXECUTION_RECEIPTS_PATH=/opt/velvet/state/receipts/execution.log
VELVET_TOKEN_REPLAY_LEDGER_PATH=/opt/velvet/state/execution/consumed_tokens.jsonl

# Runtime -> Audio Studio speech delivery is deliberately opt-in.
# Leave VELVET_AUDIO_SPEECH_ENDPOINT unset to preserve the current inert posture.
# For a non-loopback endpoint, VELVET_AUDIO_SPEECH_TOKEN_FILE is mandatory.
# The token file must contain only the shared bearer token and should be root-owned.
#
# VELVET_AUDIO_SPEECH_ENDPOINT=http://192.168.50.20:8766/v1/speech-expressions
# VELVET_AUDIO_SPEECH_EGRESS_DB=/opt/velvet/state/audio/speech-egress.sqlite3
# VELVET_AUDIO_SPEECH_TOKEN_FILE=/etc/velvet/audio-speech.token
# VELVET_AUDIO_SPEECH_TIMEOUT_SECONDS=0.75
# VELVET_AUDIO_SPEECH_MAX_PENDING=256
