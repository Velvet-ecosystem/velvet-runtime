# Copy to /etc/velvet/seat-driver.env only after physical verification.
VELVET_SEAT_NODE_DEVICE=/dev/velvet-seat-driver
VELVET_SEAT_NODE_BAUD=115200
VELVET_SEAT_NODE_ID=seat-node-driver
VELVET_SEAT_ID=driver
VELVET_SEAT_MODULE_ID=seat-presence-driver
VELVET_SEAT_SENSOR_MODEL=HLK-LD2410C
VELVET_SEAT_STALE_AFTER_MS=3500
VELVET_SEAT_FAILURE_THRESHOLD=3
