[Unit]
Description=Velvet Founder Receive-Only CAN Body Bridge
Documentation=file:/opt/velvet/velvet-runtime/docs/founder_body_state_bridge.md
After=local-fs.target velvet-runtime.service
Wants=velvet-runtime.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=velvet
Group=velvet
WorkingDirectory=/opt/velvet/velvet-runtime
EnvironmentFile=-/etc/velvet/founder-body-state.env
ExecStart=/usr/bin/python3 scripts/can_body_state_bridge.py
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
RuntimeDirectory=velvet
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
StateDirectory=velvet-runtime
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/velvet /var/lib/velvet-runtime
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_CAN AF_NETLINK AF_UNIX

[Install]
WantedBy=multi-user.target
